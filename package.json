{
  "name": "binharness",
  "version": "0.6.7",
  "description": "Binary-analysis tools for supplied files: hex viewing, NSO/NRO parsing, container listings, disassembly, heuristic function/name recovery, and Ghidra/IDA export. Includes an MCP server and model API CLI.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "deepseek-bin": "harness/deepseek-bin.mjs",
    "binharness-mcp": "plugins/hex-viewer/server.mjs"
  },
  "files": [
    "plugins/hex-viewer/lib",
    "plugins/hex-viewer/server.mjs",
    "plugins/hex-viewer/assets/app.html",
    "harness",
    "scripts/audit-dist.mjs",
    "scripts/dist-policy.json",
    "docs/distribution-audit.md",
    "PROVENANCE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit:dist": "node scripts/audit-dist.mjs",
    "audit:history": "node scripts/audit-dist.mjs --history",
    "prepack": "node scripts/audit-dist.mjs --package-only"
  },
  "engines": { "node": ">=18" },
  "keywords": [
    "reverse-engineering", "nintendo-switch", "nso", "aarch64", "disassembler",
    "hex-viewer", "mcp", "binary", "rtti", "ghidra", "ida", "deepseek"
  ],
  "homepage": "https://github.com/dougchansan/binharness",
  "bugs": "https://github.com/dougchansan/binharness/issues",
  "repository": "github:dougchansan/binharness"
}
